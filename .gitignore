# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
# NOTE: dist/ IS committed on purpose. It is the ready-to-deploy website,
# so you can download the repository and upload dist/ to Hostinger without
# installing Node. Regenerate it any time with `npm run build`.
# dist/

# ---- Source images that are regenerated by `npm run images` ----
# The optimised WebP derivatives in public/images ARE committed, because
# the build and the deployed site both need them. The raw PNGs are not.
.raw-images/

# ---- Local environment ----
.env
.env.local
.env.*.local

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs and temp ----
*.log
npm-debug.log*
yarn-error.log*
.cache/
.tmp/

# ---- QA harness output (local verification only) ----
.qa/shots/
.qa/report.json

# ---- Hostinger / cPanel artefacts ----
.cpanel/
.passenger/
