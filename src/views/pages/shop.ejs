<%
/**
 * Shop index.
 * @param products    products for this page
 * @param pagination  pagination descriptor
 * @param collections product categories with counts
 */
%>
<section class="page-hero">
  <div class="page-hero-bg">
    <%- heroImage('main', '', { width: 1280, height: 500 }) %>
  </div>
  <div class="container">
    <%- include('../partials/breadcrumbs.ejs', { trail: trail, onDark: true }) %>
    <span class="eyebrow eyebrow-plain" style="color:var(--lime-400)">Handmade in our workshop</span>
    <h1>The collection</h1>
    <p>Thirty pieces woven by hand from natural palm and coconut leaves. Made to be used, not just looked at.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="shop-layout">

      <aside class="filter-panel" aria-label="Shop filters">
        <div class="filter-card">
          <h4>Collections</h4>
          <ul class="filter-list">
            <li>
              <a href="<%= relUrl('shop') %>" class="<%= !activeCollection ? 'is-active' : '' %>">
                All products <span class="count"><%= pagination.total %></span>
              </a>
            </li>
            <% collections.forEach(function (c) { %>
              <li>
                <a href="<%= relUrl('collection/' + c.slug) %>" class="<%= activeCollection === c.slug ? 'is-active' : '' %>">
                  <%= c.name %> <span class="count"><%= c.count %></span>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>

        <div class="filter-card">
          <h4>Price</h4>
          <ul class="filter-list">
            <li><a href="<%= relUrl('shop') %>?price=under-20">Under <%= money(20) %></a></li>
            <li><a href="<%= relUrl('shop') %>?price=20-40"><%= money(20) %> – <%= money(40) %></a></li>
            <li><a href="<%= relUrl('shop') %>?price=over-40">Over <%= money(40) %></a></li>
          </ul>
        </div>

        <div class="filter-card" style="background:var(--lime-100);border-color:var(--lime-200)">
          <h4 style="border-color:var(--lime-200)">Free shipping</h4>
          <p style="font-size:.86rem;color:var(--ink-soft);margin:0 0 12px">
            Free tracked shipping on every order over <%= money(site.freeShippingThreshold) %>.
          </p>
          <p style="font-size:.82rem;color:var(--muted);margin:0">
            <%- icon('refresh', '', 14) %> <%= site.returnsNote %>
          </p>
        </div>
      </aside>

      <div>
        <div class="shop-toolbar">
          <span class="result-count">
            Showing <strong><%= pagination.from %>–<%= pagination.to %></strong> of <strong><%= pagination.total %></strong> products
          </span>
          <form method="get" action="<%= relUrl('shop') %>">
            <label class="sr-only" for="sort">Sort products</label>
            <select name="sort" id="sort" onchange="this.form.submit()">
              <option value="featured" <%= sort === 'featured' ? 'selected' : '' %>>Featured</option>
              <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price: low to high</option>
              <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option>
              <option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Best rated</option>
              <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
            </select>
          </form>
        </div>

        <% if (!products.length) { %>
          <div class="empty-state">
            <div class="es-icon"><%- icon('box', '', 40) %></div>
            <h2>Nothing in stock here</h2>
            <p>This filter has no matches. Try another collection or clear the filters.</p>
            <a href="<%= relUrl('shop') %>" class="btn btn-primary">View everything</a>
          </div>
        <% } else { %>
          <div class="grid grid-3">
            <% products.forEach(function (p, i) { %>
              <%- include('../partials/product-card.ejs', { product: p, eager: i < 3 }) %>
            <% }); %>
          </div>
          <%- include('../partials/pagination.ejs', { pagination: pagination }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>
