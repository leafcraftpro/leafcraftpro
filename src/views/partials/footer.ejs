<%
const socials = Object.entries(site.social).filter(function (e) { return e[1]; });
const topics = locals.topicNav || [];
const collections = locals.collectionNav || [];
const year = new Date().getFullYear();
%>
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-brand footer-col">
        <span class="brand">
          <img class="brand-logo" src="<%= relUrl('assets/img/logo-light-500.webp') %>"
               srcset="<%= relUrl('assets/img/logo-light-500.webp') %> 500w, <%= relUrl('assets/img/logo-light.webp') %> 1000w"
               sizes="190px" width="190" height="50" alt="<%= site.name %>"
               loading="lazy" decoding="async">
        </span>
        <p><%= site.longDescription %></p>

        <div class="social-row">
          <% socials.forEach(function (s) { %>
            <a href="<%= s[1] %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s[0] %>"><%- icon(s[0], '', 17) %></a>
          <% }); %>
        </div>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="<%= relUrl('blog') %>">All craft guides</a></li>
          <li><a href="<%= relUrl('shop') %>">Shop the collection</a></li>
          <li><a href="<%= relUrl('topics') %>">Browse by topic</a></li>
          <li><a href="<%= relUrl('craft-glossary') %>">Craft glossary</a></li>
          <li><a href="<%= relUrl('about') %>">Our craft story</a></li>
          <li><a href="<%= relUrl('sitemap') %>">Site map</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Popular topics</h4>
        <ul>
          <% topics.slice(0, 6).forEach(function (c) { %>
            <li><a href="<%= relUrl('topic/' + c.slug) %>"><%= c.name %></a></li>
          <% }); %>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Shop</h4>
        <ul>
          <% collections.slice(0, 6).forEach(function (c) { %>
            <li><a href="<%= relUrl('collection/' + c.slug) %>"><%= c.name %></a></li>
          <% }); %>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="footer-contact">
          <li><%- icon('mail', '', 16) %><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
          <li><%- icon('whatsapp', '', 16) %><a href="https://wa.me/<%= site.whatsappHref %>" target="_blank" rel="noopener noreferrer">WhatsApp <%= site.whatsapp %></a></li>
          <li><%- icon('phone', '', 16) %><a href="tel:<%= site.phoneHref %>"><%= site.phone %></a></li>
          <li><%- icon('map-pin', '', 16) %><span><%= site.address.street %>, <%= site.address.city %>, <%= site.address.region %> <%= site.address.postalCode %></span></li>
          <li><%- icon('clock', '', 16) %><span>Mon–Fri, 9am–5pm</span></li>
        </ul>
      </div>
    </div>

    <div class="newsletter-band" style="margin-bottom:38px">
      <div>
        <h3>Crafting with nature brings happiness</h3>
        <p>Join the newsletter for one new guide a week, plus the occasional honest note about what went wrong on the bench.</p>
      </div>
      <form data-newsletter data-mailto="<%= site.email %>" novalidate>
        <label class="sr-only" for="footer-email">Email address</label>
        <input type="email" id="footer-email" name="email" placeholder="Your email address" required autocomplete="email">
        <button type="submit" class="btn btn-lime">Subscribe <%- icon('arrow-right', '', 16) %></button>
      </form>
    </div>

    <div class="footer-bottom">
      <div>&copy; <%= year %> <%= site.name %>. All rights reserved.</div>
      <div class="fb-links">
        <a href="<%= relUrl('privacy-policy') %>">Privacy</a>
        <a href="<%= relUrl('cookie-policy') %>">Cookies</a>
        <a href="<%= relUrl('terms') %>">Terms</a>
        <a href="<%= relUrl('shipping-returns') %>">Shipping &amp; Returns</a>
        <a href="<%= relUrl('accessibility') %>">Accessibility</a>
        <a href="<%= relUrl('sitemap.xml') %>">Sitemap</a>
      </div>
      <span class="footer-signature"><%- icon('leaf', '', 15) %> Handmade with nature</span>
    </div>
  </div>
</footer>
