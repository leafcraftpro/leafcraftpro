<%
/**
 * Blog post card.
 * @param post  a decorated post object
 * @param eager boolean — load the image eagerly (above the fold)
 */
const p = post;
const eager = !!locals.eager;
const entry = (manifest.blog && manifest.blog[p.slug]) || {};
const sizes = '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px';
%>
<article class="post-card reveal">
  <a class="card-media" href="<%= relUrl(p.slug) %>" aria-label="<%= p.title %>">
    <%- blogImage(p.slug, p.imageAlt || p.title, {
      sizes: sizes,
      width: 640,
      height: 427,
      lazy: !eager,
      fetchpriority: eager ? 'high' : '',
      lqip: entry.lqip || '',
      widths: entry.widths || null
    }) %>
    <% if (p.category) { %>
      <span class="card-badge"><%= p.category.shortName || p.category.name %></span>
    <% } %>
  </a>
  <div class="card-body">
    <h3><a href="<%= relUrl(p.slug) %>"><%= p.title %></a></h3>
    <p><%= excerpt(p.excerpt || p.intro, 105) %></p>
    <div class="card-meta">
      <span><%- icon('clock', '', 14) %> <%= p.readTime %> min read</span>
      <% if (p.difficulty) { %>
        <span><%- icon('award', '', 14) %> <%= p.difficulty %></span>
      <% } %>
      <span><%- icon('calendar', '', 14) %> <%= formatDate(p.publishedAt, 'short') %></span>
    </div>
  </div>
</article>
