<%
/**
 * Base layout.
 * Receives: body (rendered view HTML) and seo (SEO descriptor).
 *
 * NOTE: the descriptor is `seo`, NOT `page`. Information pages pass their own
 * content object as `page`, and passing the descriptor under that name
 * overwrote it — which silently rendered six pages with an empty body. The
 * `|| page` fallback is only for safety; nothing should rely on it.
 */
const p = seo || page || {};
const bClass = bodyClass || '';
%><!DOCTYPE html>
<html lang="<%= site.language %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="<%= site.themeColor %>">
<meta name="format-detection" content="telephone=no">

<%- renderMeta(p) %>

<link rel="icon" href="<%= relUrl('assets/img/favicon.svg') %>" type="image/svg+xml">
<link rel="apple-touch-icon" href="<%= relUrl('assets/img/favicon.svg') %>">
<link rel="manifest" href="<%= relUrl('manifest.webmanifest') %>">
<link rel="sitemap" type="application/xml" href="<%= relUrl('sitemap.xml') %>">
<link rel="alternate" type="application/rss+xml" title="<%= site.name %> — Craft Guides" href="<%= relUrl('feed.xml') %>">
<%# llms.txt proposal: advertise the markdown twin and the index that covers
    this page, so agents do not have to guess at URLs. %>
<link rel="describedby" type="text/plain" href="<%= relUrl('llms.txt') %>">
<% if (markdownTwin) { %>
<link rel="alternate" type="text/markdown" href="<%= relUrl(markdownTwin) %>">
<% } %>

<%# Fonts are self-hosted and declared in style.css, so there is no
    third-party stylesheet to fetch. They are deliberately NOT preloaded:
    both faces use font-display: swap, so text paints immediately with the
    fallback and swapping later costs nothing. Preloading them would compete
    for bandwidth with the LCP image below. %>
<% if (preloadImage) { %>
<link rel="preload" as="image"
      href="<%= preloadImage.href %>"
      imagesrcset="<%= preloadImage.srcset %>"
      imagesizes="<%= preloadImage.sizes %>"
      fetchpriority="high">
<% } %>

<link rel="stylesheet" href="<%= relUrl('assets/css/style.css') %>">

<%- renderSchema(p.schema || []) %>

<% if (site.analytics.googleAnalyticsId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analytics.googleAnalyticsId %>"></script>
<script>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('js',new Date());gtag('config','<%= site.analytics.googleAnalyticsId %>');
</script>
<% } %>
</head>
<body class="<%= bClass %> no-js">
<script>document.body.classList.remove('no-js');</script>

<a class="skip-link" href="#main">Skip to content</a>

<div class="reading-progress" aria-hidden="true"></div>

<%- include('../partials/header.ejs') %>

<main id="main">
<%- body %>
</main>

<%- include('../partials/footer.ejs') %>
<%- include('../partials/search-overlay.ejs') %>

<button type="button" class="to-top" aria-label="Back to top">
  <%- icon('chevron-down', '', 20) %>
</button>

<script src="<%= relUrl('assets/js/main.js') %>" defer></script>
</body>
</html>
