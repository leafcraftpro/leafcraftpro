<%
/**
 * Base layout.
 * Receives: body (rendered view HTML) and page (SEO descriptor).
 */
const p = page || {};
const bClass = bodyClass || '';
%><!DOCTYPE html>
<html lang="<%= site.language %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="<%= site.themeColor %>">
<meta name="format-detection" content="telephone=no">

<%- renderMeta(p) %>

<link rel="icon" href="<%= relUrl('assets/img/favicon.svg') %>" type="image/svg+xml">
<link rel="apple-touch-icon" href="<%= relUrl('assets/img/favicon.svg') %>">
<link rel="manifest" href="<%= relUrl('manifest.webmanifest') %>">
<link rel="sitemap" type="application/xml" href="<%= relUrl('sitemap.xml') %>">
<link rel="alternate" type="application/rss+xml" title="<%= site.name %> — Craft Guides" href="<%= relUrl('feed.xml') %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'">
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap">
</noscript>

<link rel="stylesheet" href="<%= relUrl('assets/css/style.css') %>">

<%- renderSchema(p.schema || []) %>

<% if (site.analytics.googleAnalyticsId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analytics.googleAnalyticsId %>"></script>
<script>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('js',new Date());gtag('config','<%= site.analytics.googleAnalyticsId %>');
</script>
<% } %>
</head>
<body class="<%= bClass %> no-js">
<script>document.body.classList.remove('no-js');</script>

<a class="skip-link" href="#main">Skip to content</a>

<div class="reading-progress" aria-hidden="true"></div>

<%- include('../partials/header.ejs') %>

<main id="main">
<%- body %>
</main>

<%- include('../partials/footer.ejs') %>
<%- include('../partials/search-overlay.ejs') %>

<button type="button" class="to-top" aria-label="Back to top">
  <%- icon('chevron-down', '', 20) %>
</button>

<script src="<%= relUrl('assets/js/main.js') %>" defer></script>
</body>
</html>
