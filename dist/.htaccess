# ============================================================
#  LeafCraftPRO — Apache configuration for the STATIC build.
#  Copied into dist/ by `npm run build`.
#  Upload it to public_html alongside the generated folders.
#
#  Design rules for this file (they matter on shared hosting):
#   * Only directives inside <IfModule> guards, so a host that
#     lacks a module gets a working site rather than a 500.
#   * `Options -Indexes` only — never `-MultiViews`. MultiViews
#     is a negotiated content filter and is ignored on LiteSpeed,
#     and the `Options` directive itself is rejected by hosts
#     that run with AllowOverride Options disallowed.
#   * No forced HTTPS rewrite by default. Turn it on only after
#     the certificate is active (see the block below).
#   * Everything here is HTTP-level. A 503 that appears on EVERY
#     URL — including static .css and .webp files — is a server
#     or resource-limit problem, not an .htaccess problem.
# ============================================================

# ---------- DEFAULTS ----------
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
</IfModule>
DirectoryIndex index.html

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ---------- URL REWRITING ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # If you deploy into a sub-folder (e.g. /leafcraft), uncomment and edit:
    # RewriteBase /leafcraft/

    # --- Force HTTPS -------------------------------------------------
    # LEAVE THIS COMMENTED OUT until the Let's Encrypt certificate is
    # actually active. Enabling it early produces a redirect loop, and
    # behind a load balancer it can bounce requests forever.
    # Uncomment the three lines below once SSL works:
    #
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # --- Let real files and folders through untouched -----------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Otherwise resolve the clean URL ------------------------------
    # /blog  ->  /blog/index.html   then   /blog.html
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ /$1/index.html [L]

    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ /$1.html [L]
</IfModule>

# ---------- ERROR DOCUMENTS ----------
ErrorDocument 404 /404.html

# ---------- SECURITY ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header unset X-Powered-By
</IfModule>

# --- Block access to backend and source files ---------------------
# Harmless for the static build (none of these exist in dist/), but
# the Node deployment shares a docroot with the project, so this is
# the belt to go with package.json's braces.
# Note: no `lock` here on purpose — it would also block .htaccess.
<FilesMatch "\.(md|log|ini|bak|sh|yml|yaml|map|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(package(-lock)?\.json|build\.js|server\.js|app\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# ---------- PERFORMANCE ----------

# --- GZIP compression ---
# AddOutputFilterByType lives in mod_filter, so both modules must be
# present or the host returns 500 on every request.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
        AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
        AddOutputFilterByType DEFLATE application/rss+xml application/javascript
        AddOutputFilterByType DEFLATE application/json application/ld+json
        AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
    </IfModule>
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/manifest+json     "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(webp|svg|css|js|woff2)$">
        Header unset ETag
    </FilesMatch>
</IfModule>
FileETag None

# ---------- MIME TYPES ----------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
    AddType application/json .json
</IfModule>

# ---------- REDUCE PROCESS COUNT ON SHARED HOSTING ----------
# Each concurrent request on this host may cost a worker process.
# Hostinger returns "503 Service Unavailable — the server is
# temporarily busy" as soon as the plan's process/RAM ceiling is hit.
# Turning keep-alive off frees a worker as soon as a response is
# finished instead of holding it open, which is the single easiest
# way to lower the peak count for a low-traffic content site.
#
# If your host's Resources Usage shows the process limit being hit,
# make sure the two lines below are NOT commented out.
<IfModule mod_headers.c>
    Header set Connection close
</IfModule>
