# ============================================================
#  LeafCraftPRO — environment template
#  Copy to `.env` and edit. Every value here is optional:
#  the site builds and runs with sensible defaults.
# ============================================================

# ---- Site identity -----------------------------------------
# Used for canonical URLs, Open Graph, the sitemap and robots.txt.
# Change this before your final build.
SITE_URL=https://leafcraftpro.site

# Set this only if the site is NOT at the domain root.
# Example for https://example.com/leafcraft → /leafcraft
SITE_BASE_PATH=

# ---- Server (Node.js deployment only) ----------------------
PORT=3000
NODE_ENV=production

# Passenger (Hostinger) sets these automatically; leave blank.
# HOST=0.0.0.0
