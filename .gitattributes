# Normalise line endings so the repository is identical on every machine.
# Text files are stored with LF; Windows checkouts get CRLF automatically.
* text=auto eol=lf

# Never touch binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary

# Generated output — keep GitHub from counting these as source.
dist/** linguist-generated=true
public/images/** linguist-generated=true
src/data/image-manifest.json linguist-generated=true
package-lock.json -diff linguist-generated=true
